# Copy to .env for local dev (gitignored). In production, set these as
# Environment Variables in the Vercel project dashboard instead — never commit
# real values here.

# Google Cloud Console > APIs & Services > Credentials
# Enable: Maps JavaScript API, Geocoding API
GOOGLE_MAPS_API_KEY=

# Foursquare Developer Console (foursquare.com/developers)
FOURSQUARE_API_KEY=

# Hotelbeds APItude (developer.hotelbeds.com) - register for free, no card
# required, and use the keys from your dashboard. These only work against the
# test/sandbox environment (api.test.hotelbeds.com) and are capped at 50
# requests/day on the free evaluation tier.
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=

# Only needed if the frontend is ever hosted on a different origin than the
# API (not the case for the default same-origin Vercel deploy).
FRONTEND_URL=http://localhost:3000
